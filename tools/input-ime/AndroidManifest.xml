<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.appvanta.input" android:versionCode="4" android:versionName="0.4.0">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
  <uses-permission android:name="android.permission.CAMERA" />
  <application android:label="AppVanta Test Input" android:allowBackup="false">
    <receiver android:name=".ClipboardReceiver" android:exported="true" android:permission="android.permission.DUMP">
      <intent-filter><action android:name="dev.appvanta.input.SET_CLIPBOARD" /></intent-filter>
    </receiver>
    <activity android:name=".FaultActivity" android:exported="true" android:permission="android.permission.DUMP" />
    <activity android:name=".AnrActivity" android:exported="true" android:permission="android.permission.DUMP" />
    <activity android:name=".NativeFaultActivity" android:exported="true" android:permission="android.permission.DUMP" />
    <activity android:name=".GestureActivity" android:exported="true" android:permission="android.permission.DUMP" />
    <service android:name=".InputService" android:exported="true" android:permission="android.permission.BIND_INPUT_METHOD">
      <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/method" />
    </service>
    <service android:name=".GestureService" android:label="AppVanta Gesture Service" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility" />
    </service>
  </application>
</manifest>
