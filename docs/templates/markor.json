{
  "version": 1,
  "name": "Parameterized Markor launch",
  "variables": { "app": "net.gsantner.markor", "timeout": 10000 },
  "applications": [{ "$var": "app" }],
  "fragments": {
    "launchAndWait": {
      "parameters": ["package"],
      "steps": [{
        "description": "Launch and verify process",
        "launchPackage": { "$var": "package" },
        "action": {
          "kind": "wait",
          "condition": { "kind": "app-running", "packageName": { "$var": "package" } },
          "timeoutMs": { "$var": "timeout" }
        }
      }]
    }
  },
  "steps": [
    { "use": "launchAndWait", "with": { "package": { "$var": "app" } } },
    {
      "description": "Skip absent application",
      "when": { "kind": "app-running", "packageName": "dev.appvanta.condition.absent" },
      "launchPackage": "dev.appvanta.condition.absent"
    },
    {
      "description": "Confirm conditional output",
      "when": { "kind": "app-running", "packageName": { "$var": "app" } },
      "echo": "Markor process is running"
    }
  ]
}
